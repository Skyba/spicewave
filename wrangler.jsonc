{
  // bps.basilev.com, a Cloudflare Worker: static page plus the signalling that lets two devices find each other.
  "name": "spicewave",
  "compatibility_date": "2026-09-01",
  "main": "src/worker.js",
  "assets": { "directory": "web" },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "routes": [{ "pattern": "bps.basilev.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
